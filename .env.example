# Copy to .env and fill in. All values are optional except GM_PIN.
PORT=3000
# Time zone for scheduled missions, recaps and quiet hours (IANA name)
TZ=Europe/Oslo
# Shown in the app and notifications
APP_NAME=JoyfullProdiGs
# Secret PIN that unlocks the hidden Game Master panel (only for players flagged as GM)
GM_PIN=change-me
# Contact for push services. Apple rejects localhost, so use a real mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com
# Leave empty to auto-generate and store keys in the database on first start
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Trip window. The GM starts the game with the START button in the GM panel.
# TRIP_START is only a fallback: if nobody pressed START by then, the game starts itself.
# Final standings go out at FINAL_AT. Include the time zone offset (Norway in winter is +01:00).
TRIP_START=2026-11-27T18:00:00+01:00
FINAL_AT=2026-11-29T22:00:00+01:00
# First boot only: create these players (* = Game Master, ~ = mix-up pair) and give the GM this code
SEED_PLAYERS=Thor-Stian*,Nikolai,Christoffer,Simen,Jens~,Ivar~
GM_CODE=
# Where the SQLite file lives
DATA_DIR=./data
